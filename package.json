{
  "name": "zenode",
  "productName": "Zenode",
  "version": "0.1.0",
  "description": "A fast, local-first Markdown knowledge base.",
  "main": "./out/main/index.js",
  "author": "Zenode",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "test": "esbuild tests/index.test.ts --bundle --platform=node --format=esm --outfile=out/tests/index.test.mjs --log-level=warning && node out/tests/index.test.mjs",
    "test:e2e": "electron-vite build && playwright test"
  },
  "build": {
    "appId": "app.zenode.desktop",
    "productName": "Zenode",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "d3-force": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.9.0": true,
    "electron-winstaller": false
  }
}
