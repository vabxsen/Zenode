{
  "name": "zenode",
  "productName": "Zenode",
  "version": "0.5.0",
  "description": "A fast, local-first Markdown knowledge base.",
  "main": "./out/main/index.js",
  "author": "Vaibhav Sen",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "test": "esbuild tests/run.ts --bundle --platform=node --format=esm --external:yaml --outfile=out/tests/run.mjs --log-level=warning && node out/tests/run.mjs",
    "test:e2e": "npm run test:e2e:build && playwright test",
    "test:e2e:build": "electron-vite build --outDir out-e2e",
    "bench": "npm run test:e2e:build && node scripts/bench.mjs",
    "soak": "npm run test:e2e:build && node scripts/soak.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:install": "node scripts/check-install.mjs"
  },
  "build": {
    "appId": "app.zenode.desktop",
    "productName": "Zenode",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/help-vault",
        "to": "help-vault"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "legalTrademarks": "Zenode"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "Zenode-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Zenode",
      "uninstallDisplayName": "Zenode ${version}"
    },
    "copyright": "Copyright © 2026 Vaibhav Sen",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Zenode.Note",
        "description": "Markdown note",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "canvas",
        "name": "Zenode.Canvas",
        "description": "Zenode canvas",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "portable": {
      "artifactName": "Zenode-${version}-portable.${ext}"
    },
    "artifactName": "Zenode-${version}-win-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "vabxsen",
        "repo": "Zenode",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.63.0",
    "@types/d3-force": "^3.0.10",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^22.20.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.10",
    "katex": "^0.18.11",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.17.2",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.9.0": true,
    "electron-winstaller": false
  },
  "overrides": {
    "katex": "$katex"
  },
  "homepage": "https://github.com/vabxsen/Zenode",
  "repository": {
    "type": "git",
    "url": "https://github.com/vabxsen/Zenode.git"
  }
}
